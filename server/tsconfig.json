{
	"compilerOptions": {
		"module": "ES2022",
		"lib": [
			"ES6",
			"dom"
		],
		"rootDirs": [
			"./src"
		],
		"outDir": "./build",
		"allowJs": true,
		"target": "es2017",
		"esModuleInterop": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"moduleResolution": "node",
		"strictNullChecks": true,
	},
	"include": [
		"./src/**/*"
	],
	"exclude": [
		"node_modules"
	],
    
      "compilerOptions": {
        "skipLibCheck": true,           
        "moduleResolution": "node",     
        "allowSyntheticDefaultImports": true
      },
      "exclude": ["node_modules"]      
    
}
